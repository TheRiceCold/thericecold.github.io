---
import '../styles/global.css'

import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import InfoModal from '../components/InfoModal.astro'

const {
  page,
  noFooter = false,
  description = "TheRiceCold's Website"
} = Astro.props

---
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" data-i18n-attr="content:description">
  <title data-i18n="title,page" data-i18n-sep=" | "></title>
  <link rel="icon" type="image/svg+xml" href="/me.svg">
</head>
<body>
  <Header/>
  <main id={page}>
    <slot/>
  </main>
  {!noFooter && <Footer/>}
  <div id="modal">
    <section>
      <h3></h3>
      <p></p>
      <div><h5>Related:</h5></div>
    </section>
  </div>
</body>
</html>
