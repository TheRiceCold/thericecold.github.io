---

import {registerScript} from '../scripts/registerScript'

import '../styles/about.css'
import '../styles/aside.css'

import Me from '../../public/me.svg'

import Layout from '../layouts/Layout.astro'
import Sidebar from '../components/Sidebar.astro'
import Navigator from '../components/Navigator.astro'

const name = 'Dale Walter García Hicban'

const shortcuts = [
  {isI18n: true, label: 'Resume', link:''},
  {isI18n: true, label: 'Projects', link:'/projects'},
  {label: 'GitHub', link: 'https://github.com/thericecold' },
  {label: 'Twitter', link: 'https://x.com/thericecold'},
  {label: 'TikTok', link: 'https://tiktok.com/@thericecold'},
  {label: 'Instagram', link: 'https://instagram.com/thericecold'},
  {label: 'Spotify', link: 'https://invite.duolingo.com/BDHTZTB5CWWKT5KLM744IL2KSY'},
]

const script = await registerScript({page:'about'})

---

<Layout page="about" description="About TheRiceCold">
  <Sidebar/>

  <article>
    <h3>{name}</h3>
    <small data-i18n-html="profession"/>
    <ul>
      <template data-i18n-list="summary">
        <p data-i18n-item data-i18n-html/>
      </template>
    </ul>

    <h5 data-i18n="education.head"/>
    <p data-i18n-html="education.content"/>

    <h5 data-i18n="programming.head"/>
    <p data-i18n-html="programming.content"/>

    <h5 data-i18n="languages.head"/>
    <p data-i18n-html="languages.content"/>

    <h5 data-i18n="extra.head"/>
    <p data-i18n-html="extra.content"/>

    <h4 data-i18n="more" id="term"/>
  </article>
  <Navigator title="visit" shortcuts={shortcuts} />
  <script is:inline set:html={script.code}></script>
</Layout>
