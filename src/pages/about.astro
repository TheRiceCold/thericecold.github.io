---

import {registerScript} from '../scripts/registerScript'

import '../styles/about.css'
import '../styles/aside.css'

import Me from '../../public/me.svg'

import Layout from '../layouts/Layout.astro'
import Sidebar from '../components/Sidebar.astro'
import Navigator from '../components/Navigator.astro'
import MobileSidebar from '../components/MobileSidebar.astro'

const name = 'Dale Walter García Hicban'

const shortcuts = [
  {isI18n: true, label: 'Projects', link:'/projects'},
  {label: 'GitHub', link: 'https://github.com/thericecold' },
  {label: 'X (Twitter)', link: 'https://x.com/thericecold'},
  {label: 'Spotify', link: 'https://invite.duolingo.com/BDHTZTB5CWWKT5KLM744IL2KSY'},
  {label: 'TikTok', link: 'https://tiktok.com/@thericecold'},
]

const script = await registerScript({page:'about'})

---

<Layout page="about" description="About TheRiceCold">
  <Sidebar/><MobileSidebar/>
  <article>
    <h3>{name}</h3>
    <small data-i18n-html="profession"/><hr/>
    <ul>
      <template data-i18n-list="summary">
        <p data-i18n-item data-i18n-html/>
      </template>
    </ul><hr/>

    <h4 data-i18n="education.head"/>
    <p data-i18n-html="education.content"/><hr/>

    <h4 data-i18n="programming.head"/>
    <p data-i18n-html="programming.content"/><hr/>

    <h4 data-i18n="languages.head"/>
    <p data-i18n-html="languages.content"/><hr/>

    <h4 data-i18n="extra.head"/>
    <p data-i18n-html="extra.content"/></hr>
  </article>

  <Navigator title="visit" shortcuts={shortcuts} />
  <script is:inline set:html={script.code}/>
</Layout>
